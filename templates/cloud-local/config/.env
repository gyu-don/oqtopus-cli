# general
ENV=local
LOG_LEVEL=DEBUG

# API startup options (uvicorn / Powertools)
# Any uvicorn option can be set as <SCOPE>_<OPTION> (e.g. USER_API_WORKERS).
# The port has no default, so it must be set for every API.
USER_API_HOST=0.0.0.0
USER_API_PORT=8080
USER_API_RELOAD=true
USER_API_LOG_LEVEL=debug
USER_API_POWERTOOLS_SERVICE_NAME=user-api
USER_API_POWERTOOLS_METRICS_NAMESPACE=user-api

PROVIDER_API_HOST=0.0.0.0
PROVIDER_API_PORT=8888
PROVIDER_API_RELOAD=true
PROVIDER_API_LOG_LEVEL=debug
PROVIDER_API_POWERTOOLS_SERVICE_NAME=provider-api
PROVIDER_API_POWERTOOLS_METRICS_NAMESPACE=provider-api

ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8889
ADMIN_API_RELOAD=true
ADMIN_API_LOG_LEVEL=debug
ADMIN_API_POWERTOOLS_SERVICE_NAME=admin-api
ADMIN_API_POWERTOOLS_METRICS_NAMESPACE=admin-api

USER_SIGNUP_API_HOST=0.0.0.0
USER_SIGNUP_API_PORT=8890
USER_SIGNUP_API_RELOAD=true
USER_SIGNUP_API_LOG_LEVEL=debug
USER_SIGNUP_API_POWERTOOLS_SERVICE_NAME=user_signup-api
USER_SIGNUP_API_POWERTOOLS_METRICS_NAMESPACE=user_signup-api

# CORS
ALLOW_ORIGINS=http://127.0.0.1:8000
ALLOW_CREDENTIALS=true
ALLOW_METHODS=*
ALLOW_HEADERS=*

# database
DB_HOST=localhost
DB_NAME=main
DB_CONNECTOR=mysql+pymysql
DB_USERNAME=admin
DB_PASSWORD=password

# object storage
# Local object storage stack: seaweedfs | minio
# STORAGE_DRIVER is derived from STORAGE_STACK by oqtopus-cloud-infra and the API/worker commands.
STORAGE_STACK=seaweedfs

# object storage (STORAGE_STACK=seaweedfs)
STORAGE_SEAWEEDFS_BUCKET_NAME=oqtopus-oqtopus-dev
STORAGE_SEAWEEDFS_USERNAME=devadmin
STORAGE_SEAWEEDFS_PASSWORD=devadmin123
STORAGE_SEAWEEDFS_ENDPOINT_URL=http://localhost:8333
STORAGE_SEAWEEDFS_PUBLIC_ENDPOINT_URL=http://localhost:8333

# object storage (STORAGE_STACK=minio)
STORAGE_LOCAL_MINIO_BUCKET_NAME=oqtopus-oqtopus-dev
STORAGE_LOCAL_MINIO_USERNAME=minioadmin
STORAGE_LOCAL_MINIO_PASSWORD=minioadmin
STORAGE_LOCAL_MINIO_ENDPOINT_URL=http://localhost:9000

# user API
# Whether users can delete their accounts
ALLOW_DELETION=true
# User fields which can be edited by the user
EDITABLE_FIELDS=["name", "organization"]
# User fields which the user can view
VISIBLE_FIELDS=["id", "email", "name", "organization", "created_at"]
# Whether the login history is included in the GET user API response
LOGIN_HISTORY_ENABLED=true

# worker
LOCAL_WORKER_SCHEDULING_RATE_S=60
COUNT_PENDING_JOBS_SINCE=10d
